# Convex deployment URL — obtained by running `npx convex dev`
VITE_CONVEX_URL="https://your-project-123.convex.cloud"

# Clerk publishable key — obtained from your Clerk dashboard
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Stadia Maps API key — get one free at https://client.stadiamaps.com
VITE_STADIA_API_KEY="your-stadia-api-key"

# Meta / Instagram Developer App credentials
VITE_META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
